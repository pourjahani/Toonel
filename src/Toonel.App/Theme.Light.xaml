<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ Light palette: warm monochrome + spot pastels ============ -->
  <SolidColorBrush x:Key="Bg" Color="#F7F6F3"/>
  <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Border" Color="#EAEAEA"/>
  <SolidColorBrush x:Key="Fg" Color="#2F3437"/>
  <SolidColorBrush x:Key="Ink" Color="#111111"/>
  <SolidColorBrush x:Key="InkHover" Color="#333333"/>
  <SolidColorBrush x:Key="InkPressed" Color="#000000"/>
  <SolidColorBrush x:Key="OnInk" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Muted" Color="#787774"/>
  <SolidColorBrush x:Key="Hover" Color="#F2F1EE"/>

  <SolidColorBrush x:Key="PastelGreenBg" Color="#EDF3EC"/>
  <SolidColorBrush x:Key="PastelGreenTx" Color="#346538"/>
  <SolidColorBrush x:Key="PastelRedBg" Color="#FDEBEC"/>
  <SolidColorBrush x:Key="PastelRedTx" Color="#9F2F2D"/>
  <SolidColorBrush x:Key="PastelYellowTx" Color="#956400"/>
  <SolidColorBrush x:Key="PastelBlueBg" Color="#E1F3FE"/>
  <SolidColorBrush x:Key="PastelBlueTx" Color="#1F6C9F"/>
  <SolidColorBrush x:Key="IdleDot" Color="#D5D4D0"/>

  <!-- Status dots (shared by XAML and code-behind) -->
  <SolidColorBrush x:Key="DotGreen" Color="#346538"/>
  <SolidColorBrush x:Key="DotAmber" Color="#956400"/>
  <SolidColorBrush x:Key="DotRed" Color="#9F2F2D"/>
</ResourceDictionary>
