<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ Dark palette: warm charcoal, same accent hues ============ -->
  <SolidColorBrush x:Key="Bg" Color="#171715"/>
  <SolidColorBrush x:Key="CardBg" Color="#1F1F1D"/>
  <SolidColorBrush x:Key="Border" Color="#2E2E2B"/>
  <SolidColorBrush x:Key="Fg" Color="#D9D7D2"/>
  <SolidColorBrush x:Key="Ink" Color="#F2F1EE"/>
  <SolidColorBrush x:Key="InkHover" Color="#CFCDC8"/>
  <SolidColorBrush x:Key="InkPressed" Color="#B9B7B2"/>
  <SolidColorBrush x:Key="OnInk" Color="#141413"/>
  <SolidColorBrush x:Key="Muted" Color="#8F8E89"/>
  <SolidColorBrush x:Key="Hover" Color="#262624"/>

  <SolidColorBrush x:Key="PastelGreenBg" Color="#20301F"/>
  <SolidColorBrush x:Key="PastelGreenTx" Color="#8FBF87"/>
  <SolidColorBrush x:Key="PastelRedBg" Color="#381F20"/>
  <SolidColorBrush x:Key="PastelRedTx" Color="#E08B8B"/>
  <SolidColorBrush x:Key="PastelYellowTx" Color="#D9B35C"/>
  <SolidColorBrush x:Key="PastelBlueBg" Color="#1C2E3A"/>
  <SolidColorBrush x:Key="PastelBlueTx" Color="#7FB8DC"/>
  <SolidColorBrush x:Key="IdleDot" Color="#4A4A47"/>

  <!-- Status dots (lighter tints so they read on dark surfaces) -->
  <SolidColorBrush x:Key="DotGreen" Color="#7FBF76"/>
  <SolidColorBrush x:Key="DotAmber" Color="#D9B35C"/>
  <SolidColorBrush x:Key="DotRed" Color="#E07070"/>
</ResourceDictionary>
