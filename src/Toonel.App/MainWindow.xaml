<Window x:Class="Toonel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toonel" Height="700" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource SansSerif}">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ Sidebar ============ -->
    <Border Grid.Column="0" Background="{DynamicResource CardBg}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
            Padding="14,22,14,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
          <Canvas Width="22" Height="22" VerticalAlignment="Center">
            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="20" Height="20"
                       Stroke="{DynamicResource Ink}" StrokeThickness="1.6"/>
            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="6" Height="6" Fill="{DynamicResource Ink}"/>
          </Canvas>
          <TextBlock x:Name="BrandName" Text="Toonel" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="BrandTag" Text="XRAY + PSIPHON CLIENT" Style="{StaticResource MicroLabel}" Margin="4,0,0,26"/>

        <RadioButton x:Name="NavDash" Content="Dashboard" IsChecked="True" Style="{StaticResource NavButton}" GroupName="nav" Tag="Dash" Click="NavClick"/>
        <RadioButton x:Name="NavProfiles" Content="Profiles" Style="{StaticResource NavButton}" GroupName="nav" Tag="Profiles" Margin="0,2,0,0" Click="NavClick"/>
        <RadioButton x:Name="NavSplit" Content="Split Tunnel" Style="{StaticResource NavButton}" GroupName="nav" Tag="Split" Margin="0,2,0,0" Click="NavClick"/>
        <RadioButton x:Name="NavPsiphon" Content="Psiphon" Style="{StaticResource NavButton}" GroupName="nav" Tag="Psiphon" Margin="0,2,0,0" Click="NavClick"/>
        <RadioButton x:Name="NavConfigs" Content="Configs" Style="{StaticResource NavButton}" GroupName="nav" Tag="Configs" Margin="0,2,0,0" Click="NavClick"/>
        <RadioButton x:Name="NavLogs" Content="Logs" Style="{StaticResource NavButton}" GroupName="nav" Tag="Logs" Margin="0,2,0,0" Click="NavClick"/>
        <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" GroupName="nav" Tag="Settings" Margin="0,2,0,0" Click="NavClick"/>

        <Border Height="1" Background="{DynamicResource Border}" Margin="4,24,4,16"/>

        <TextBlock x:Name="SideEnginesLabel" Text="ENGINES" Style="{StaticResource MicroLabel}" Margin="4,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
          <Ellipse x:Name="SideDotXray" Width="7" Height="7" Fill="{DynamicResource IdleDot}" VerticalAlignment="Center"/>
          <TextBlock x:Name="SideXray" Text="Xray" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
          <Ellipse x:Name="SideDotPsiphon" Width="7" Height="7" Fill="{DynamicResource IdleDot}" VerticalAlignment="Center"/>
          <TextBlock x:Name="SidePsiphon" Text="Psiphon" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
          <Ellipse x:Name="SideDotTun" Width="7" Height="7" Fill="{DynamicResource IdleDot}" VerticalAlignment="Center"/>
          <TextBlock x:Name="SideTun" Text="TUN adapter" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============ Content ============ -->
    <Grid Grid.Column="1" Margin="28,22,28,22">
      <Grid x:Name="PageDash">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status header card -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24,20">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource IdleDot}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusPill" Text="DISCONNECTED" Style="{StaticResource MicroLabel}" Margin="9,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="HeadlineText" Text="Not connected" Style="{StaticResource Headline}" Margin="0,8,0,0"/>
              <TextBlock x:Name="IpCheckHint" Style="{StaticResource Dim}" Margin="0,2,0,0"
                         Text=""/>
              <TextBlock x:Name="ModeSubText" Style="{StaticResource Dim}" Margin="0,5,0,0"
                         Text="Pick how traffic should travel, then press Connect."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnCheckIp" Content="Check IP" Style="{StaticResource GhostButton}"
                      Command="{Binding CheckIpCommand}" Padding="12,9" Margin="0,0,10,0"/>
              <Button x:Name="BtnGoCompact" Content="—" Style="{StaticResource GhostButton}"
                      Click="OnGoCompactClick" Padding="12,9" FontSize="12"
                      ToolTip="Compact bar" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="BtnDisconnect" Content="Disconnect" Style="{StaticResource GhostButton}"
                      Command="{Binding DisconnectCommand}" Padding="18,9"/>
              <Button x:Name="BtnConnect" Content="Connect" Style="{StaticResource PrimaryButton}"
                      Command="{Binding ConnectCommand}" Padding="22,9" Margin="10,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Mode cards -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24,20" Margin="0,14,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="RouteLabel" Text="ROUTE" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ModeHint" Grid.Column="1" Style="{StaticResource Dim}" MaxWidth="560"
                         TextAlignment="Right" Text="Psiphon is available in every mode; it changes where the chain starts."/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="2" Margin="0,12,0,4">
              <RadioButton x:Name="ModeV2ray" GroupName="mode" Style="{StaticResource ModeCard}" Checked="OnModeCardChanged">
                <StackPanel>
                  <TextBlock x:Name="ModeV2rayTitle" Text="V2Ray" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                  <TextBlock x:Name="ModeV2raySub" Text="Your profile only. Fast, simple." Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModePsiphon" GroupName="mode" Style="{StaticResource ModeCard}" Checked="OnModeCardChanged">
                <StackPanel>
                  <TextBlock x:Name="ModePsiphonTitle" Text="Psiphon alone" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                  <TextBlock x:Name="ModePsiphonSub" Text="No profile. Everything through Psiphon." Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeAfter" GroupName="mode" Style="{StaticResource ModeCard}" Checked="OnModeCardChanged">
                <StackPanel>
                  <TextBlock x:Name="ModeAfterTitle" Text="Psiphon after V2Ray" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                  <TextBlock x:Name="ModeAfterSub" Text="Psiphon rides on your VLESS line." Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeBefore" GroupName="mode" Style="{StaticResource ModeCard}" Checked="OnModeCardChanged" Margin="0,0,0,0">
                <StackPanel>
                  <TextBlock x:Name="ModeBeforeTitle" Text="Psiphon before V2Ray" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                  <TextBlock x:Name="ModeBeforeSub" Text="VLESS rides through Psiphon first." Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeWarp" GroupName="mode" Style="{StaticResource ModeCard}" Checked="OnModeCardChanged">
                <StackPanel>
                  <TextBlock x:Name="ModeWarpTitle" Text="V2Ray over WARP" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                  <TextBlock x:Name="ModeWarpSub" Text="VLESS dials out through Cloudflare WARP first." Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>
              </RadioButton>
            </UniformGrid>

            <!-- Engine rows -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
              <TextBlock x:Name="DashEnginesLabel" Text="ENGINES" Style="{StaticResource MicroLabel}"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EngXray" Text="Xray" FontSize="13" Foreground="{DynamicResource Fg}"/>
                <TextBlock x:Name="TileXraySub" Grid.Column="1" Text="socks 10808 · http 10810" Style="{StaticResource Dim}"/>
                <TextBlock x:Name="TileXray" Grid.Column="2" Text="stopped" FontSize="12" Foreground="{DynamicResource Muted}"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource Border}" Margin="0,9,0,9"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="PsiFlagDash" Text="" FontSize="13" Margin="0,0,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
                  <TextBlock x:Name="EngPsiphon" Text="Psiphon" FontSize="13" Foreground="{DynamicResource Fg}" Margin="0,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TilePsiphonSub" Grid.Column="1" Text="socks 10811 · http 10812" Style="{StaticResource Dim}"/>
                <TextBlock x:Name="TilePsiphon" Grid.Column="2" Text="off" FontSize="12" Foreground="{DynamicResource Muted}"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource Border}" Margin="0,9,0,9"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EngTun" Text="TUN / proxy" FontSize="13" Foreground="{DynamicResource Fg}"/>
                <TextBlock x:Name="TileTunSub" Grid.Column="1" Text="split tunnel: off" Style="{StaticResource Dim}"/>
                <TextBlock x:Name="TileTun" Grid.Column="2" Text="off" FontSize="12" Foreground="{DynamicResource Muted}"/>
              </Grid>
            </StackPanel>

            <!-- Options row -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,16,0,0">
              <CheckBox x:Name="ChkTun" Content="Whole system (TUN)" IsChecked="{Binding TunEnabled, Mode=TwoWay}" Checked="OnTunChanged" Unchecked="OnTunChanged"/>
              <CheckBox x:Name="ChkSysProxy" Content="System proxy" IsChecked="{Binding SystemProxyEnabled, Mode=TwoWay}" Margin="18,0,0,0" Checked="OnSysProxyChanged" Unchecked="OnSysProxyChanged"/>
              <CheckBox x:Name="ChkQuic" Content="Block QUIC" IsChecked="{Binding BlockQuic, Mode=TwoWay}" Margin="18,0,0,0" Checked="OnBlockQuicChanged" Unchecked="OnBlockQuicChanged"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ Profiles ============ -->
      <Grid x:Name="PageProfiles" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnImportClip" Content="Import from clipboard" Style="{StaticResource PrimaryButton}" Command="{Binding ImportFromClipboardCommand}"/>
            <Button x:Name="BtnImportFile" Content="From file…" Style="{StaticResource GhostButton}" Command="{Binding ImportFromFileCommand}" Margin="8,0,0,0"/>
            <Button x:Name="BtnPing" Content="Ping" Style="{StaticResource GhostButton}" Click="OnPingProfileClick" Margin="8,0,0,0"/>
            <Button x:Name="BtnQr" Content="QR" Style="{StaticResource GhostButton}" Click="OnQrProfileClick" Margin="8,0,0,0" ToolTip="Show QR code"/>
            <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource GhostButton}" Click="OnDeleteProfileClick" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ProfilesTag" Grid.Column="1" Text="SERVERS" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
        </Grid>
        <ListView Grid.Row="1" x:Name="ProfileList" Margin="0,14,0,0"
                  ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                  SelectionMode="Extended">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="MenuCopyProfiles" Header="Copy" Click="OnCopyProfilesClick"/>
              <MenuItem x:Name="MenuPasteProfiles" Header="Paste" Click="OnPasteProfilesClick"/>
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="NAME" Width="250" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="PROTO" Width="90" DisplayMemberBinding="{Binding Protocol}"/>
              <GridViewColumn Header="SERVER" Width="230" DisplayMemberBinding="{Binding Address}"/>
              <GridViewColumn Header="PORT" Width="70" DisplayMemberBinding="{Binding Port}"/>
              <GridViewColumn Header="SECURITY" Width="100" DisplayMemberBinding="{Binding Security}"/>
              <GridViewColumn Header="NET" Width="70" DisplayMemberBinding="{Binding Network}"/>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock x:Name="SubLabel" Grid.Row="2" Style="{StaticResource MicroLabel}" Margin="0,12,0,4"
                   Text="SUBSCRIPTIONS"/>
        <Grid Grid.Row="2" Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SubHint" Style="{StaticResource Dim}" Text="Paste a subscription URL via Import from clipboard."/>
          <TextBlock x:Name="SubList" Grid.Column="1" Style="{StaticResource Dim}" TextAlignment="Right" Text=""/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
          <Button x:Name="BtnSubUpdate" Content="Update all" Style="{StaticResource GhostButton}" Click="OnSubUpdateClick"/>
        </StackPanel>
        <TextBlock x:Name="ProfilesHint" Grid.Row="2" Style="{StaticResource Dim}" Margin="0,10,0,0"
                   Text="Paste vless:// · vmess:// · trojan:// · ss:// links or a subscription URL via Import from clipboard."/>
      </Grid>

      <!-- ============ Split tunnel ============ -->
      <Grid x:Name="PageSplit" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="24,20">
          <StackPanel>
            <TextBlock x:Name="SplitLabel" Text="PER-APP ROUTING" Style="{StaticResource MicroLabel}"/>
            <TextBlock x:Name="SplitQuestion" Text="Which apps go through the tunnel?" Style="{StaticResource Headline}" FontSize="20" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <RadioButton x:Name="StOff" Content="All apps tunnel" GroupName="stmode" Checked="OnStModeChanged" Margin="0,0,20,0"/>
              <RadioButton x:Name="StInclude" Content="Only these apps" GroupName="stmode" Checked="OnStModeChanged" Margin="0,0,20,0"/>
              <RadioButton x:Name="StExclude" Content="Everyone except these" GroupName="stmode" Checked="OnStModeChanged"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="20">
            <StackPanel>
              <TextBlock x:Name="AppsLabel" Text="APPS" Style="{StaticResource MicroLabel}"/>
              <TextBlock x:Name="AppsHint" Style="{StaticResource Dim}" Margin="0,6,0,8" Text="One executable per line, e.g. chrome.exe"/>
              <TextBox x:Name="StProcesses" AcceptsReturn="true" Height="190"
                       TextChanged="OnSplitTunnelChanged" VerticalScrollBarVisibility="Auto"
                       VerticalContentAlignment="Top" TextAlignment="Left" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="12,0,0,0">
            <StackPanel>
              <TextBlock x:Name="ExcLabel" Text="EXCEPTIONS" Style="{StaticResource MicroLabel}"/>
              <TextBlock x:Name="ExcHint" Style="{StaticResource Dim}" Margin="0,6,0,8" Text="Domains, IPs/CIDRs, ports — e.g. bank.ir · 10.0.0.0/8 · 80"/>
              <TextBlock x:Name="NeverTunnelLabel" Text="Never tunnel" Style="{StaticResource Dim}" Margin="0,2,0,4"/>
              <TextBox x:Name="StDirect" AcceptsReturn="true" Height="72" TextChanged="OnSplitTunnelChanged"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextAlignment="Left" FontFamily="{StaticResource MonoFont}"/>
              <TextBlock x:Name="AlwaysTunnelLabel" Text="Always tunnel" Style="{StaticResource Dim}" Margin="0,12,0,4"/>
              <TextBox x:Name="StProxy" AcceptsReturn="true" Height="72" TextChanged="OnSplitTunnelChanged"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextAlignment="Left" FontFamily="{StaticResource MonoFont}"/>
              <CheckBox x:Name="StBypassPrivate" Content="Bypass LAN and private IPs" Margin="0,12,0,0"
                        Checked="OnSplitTunnelChanged" Unchecked="OnSplitTunnelChanged"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- ============ Psiphon ============ -->
      <Grid x:Name="PagePsiphon" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="24,20">
          <StackPanel>
            <TextBlock x:Name="PsiLabel" Text="PSIPHON" Style="{StaticResource MicroLabel}"/>
            <TextBlock x:Name="PsiQuestion" Text="Network options" Style="{StaticResource Headline}" FontSize="20" Margin="0,8,0,14"/>
            <TextBlock x:Name="PsiEgressLabel" Text="Egress country" Style="{StaticResource Dim}"/>
            <ComboBox x:Name="PsiEgress" IsEditable="True" SelectionChanged="OnEgressCountryChanged"
                      DropDownClosed="OnEgressDropDownClosed" LostFocus="OnPsiphonChanged" Margin="0,5,0,10"/>
            <TextBlock x:Name="PsiSponsorLabel" Text="Sponsor ID" Style="{StaticResource Dim}"/>
            <TextBox x:Name="PsiSponsor" TextChanged="OnPsiphonChanged" Margin="0,5,0,10"/>
            <TextBlock x:Name="PsiPropLabel" Text="Propagation channel ID" Style="{StaticResource Dim}"/>
            <TextBox x:Name="PsiProp" TextChanged="OnPsiphonChanged" Margin="0,5,0,10"/>
            <TextBlock x:Name="PsiRslLabel" Text="Remote server list URL" Style="{StaticResource Dim}"/>
            <TextBox x:Name="PsiRsl" TextChanged="OnPsiphonChanged" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24,20" Margin="12,0,0,0">
          <StackPanel>
            <TextBlock x:Name="AdvLabel" Text="ADVANCED" Style="{StaticResource MicroLabel}"/>
            <TextBlock x:Name="PsiAdvTitle" Text="Custom config" Style="{StaticResource Headline}" FontSize="20" Margin="0,8,0,14"/>
            <TextBlock x:Name="PsiAdvHint" Style="{StaticResource Dim}" Margin="0,0,0,8"
                       Text="JSON merged into client.config, or a psiphon:// link (region, protocol, sponsor, upstream). Example: psiphon://?region=DE&amp;protocol=QUIC-OSSH. UpstreamProxyURL is managed by chain modes."/>
            <TextBox x:Name="PsiCustom" AcceptsReturn="true" Height="250" TextChanged="OnPsiphonChanged"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextAlignment="Left"
                     FontFamily="{StaticResource MonoFont}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ Configs (manual per-engine editors + DPI/TLS) ============ -->
      <Grid x:Name="PageConfigs" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24,20">
          <StackPanel>
            <TextBlock x:Name="CfgLabel" Text="MANUAL CONFIGS" Style="{StaticResource MicroLabel}"/>
            <TextBlock x:Name="CfgTitle" Text="Edit engine configs" Style="{StaticResource Headline}" FontSize="20" Margin="0,8,0,8"/>
            <TextBlock x:Name="CfgHint" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="Generate fills the editor with the config Toonel would run right now — edit any part of it. Saved configs are used on the next connect; an invalid save is ignored at launch (the generated config runs instead)."/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <ComboBox x:Name="CfgEngine" Width="150" SelectionChanged="OnCfgEngineChanged">
                <ComboBoxItem Content="Xray" Tag="xray"/>
                <ComboBoxItem Content="sing-box" Tag="singbox"/>
                <ComboBoxItem Content="Psiphon" Tag="psiphon"/>
              </ComboBox>
              <Button x:Name="BtnCfgGenerate" Content="Generate" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnCfgGenerateClick"/>
              <Button x:Name="BtnCfgValidate" Content="Validate" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCfgValidateClick"/>
              <Button x:Name="BtnCfgSave" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnCfgSaveClick"/>
              <CheckBox x:Name="ChkCfgUse" Content="Use manual config" Margin="16,0,0,0" Checked="OnCfgUseChanged" Unchecked="OnCfgUseChanged"/>
              <TextBlock x:Name="CfgStatus" Style="{StaticResource Dim}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,0"/>
            <TextBlock x:Name="CfgDpiLabel" Text="DPI / TLS (baked into every generated Xray config)" Style="{StaticResource MicroLabel}" Margin="0,14,0,0"/>
            <TextBlock x:Name="CfgDpiHint" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Fragment works on every engine version. Cipher suites apply to TLS 1.0–1.2 only (a uTLS fingerprint overrides them). FinalMask needs Xray-core v26.2.6+ — press Update Xray in Settings → Binaries if your cores folder still has the old engine."/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <CheckBox x:Name="ChkDpiFragment" Content="Fragment" VerticalAlignment="Center" Checked="OnDpiChanged" Unchecked="OnDpiChanged"/>
              <TextBlock x:Name="DpiFragMini" Text="packets" Style="{StaticResource Dim}" Margin="10,0,4,0" VerticalAlignment="Center"/>
              <TextBox x:Name="DpiFragPackets" Width="90" Margin="0,0,8,0" TextChanged="OnDpiChanged"/>
              <TextBlock x:Name="DpiFragLen" Text="length" Style="{StaticResource Dim}" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBox x:Name="DpiFragLenBox" Width="90" Margin="0,0,8,0" TextChanged="OnDpiChanged"/>
              <TextBlock x:Name="DpiFragInt" Text="interval ms" Style="{StaticResource Dim}" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBox x:Name="DpiFragIntBox" Width="90" TextChanged="OnDpiChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock x:Name="DpiCipherLabel" Text="Cipher suites" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
              <TextBox x:Name="DpiCipher" Width="380" Margin="8,0,0,0" TextChanged="OnDpiChanged" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
            <TextBlock x:Name="DpiMaskLabel" Text="FinalMask (raw FinalMaskObject JSON, advanced)" Style="{StaticResource Dim}" Margin="0,10,0,4"/>
            <TextBox x:Name="CfgFinalMask" AcceptsReturn="true" Height="84" TextChanged="OnDpiChanged"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextAlignment="Left"
                     FontFamily="{StaticResource MonoFont}"/>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
          <TextBox x:Name="CfgEditor" AcceptsReturn="true" BorderThickness="0" Background="Transparent"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" TextAlignment="Left"/>
        </Border>
      </Grid>

      <!-- ============ Logs ============ -->
      <Grid x:Name="PageLogs" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="LogSourceBox" Width="150" SelectionChanged="OnLogSourceChanged"
                    ItemsSource="{Binding LogSources}" SelectedItem="{Binding SelectedLogSource, Mode=TwoWay}"/>
          <CheckBox x:Name="AutoScrollBox" Grid.Column="1" Content="Follow" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
          <Button x:Name="BtnClearLog" Grid.Column="2" Content="Clear" Style="{StaticResource GhostButton}" Click="OnClearLogClick"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
          <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Text="{Binding LogText, Mode=OneWay}"/>
        </Border>
      </Grid>

      <!-- ============ Settings ============ -->
      <Grid x:Name="PageSettings" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.ColumnDefinitions>
          <!-- Fixed width keeps the behavior/theme/language card always visible; the
               engines card takes the rest. Page is scrollable for narrow windows. -->
          <ColumnDefinition Width="400"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="24,20" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock x:Name="SetLabel" Text="SETTINGS" Style="{StaticResource MicroLabel}"/>
            <TextBlock x:Name="SetBehaviorTitle" Text="Behavior" Style="{StaticResource Headline}" FontSize="20" Margin="0,8,0,14"/>
            <CheckBox x:Name="ChkAutoConnect" Content="Connect automatically at launch" Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged"/>
            <CheckBox x:Name="ChkMinToTray" Content="Minimize to tray instead of quitting" Margin="0,10,0,0" Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged"/>
            <TextBlock x:Name="QuitHint" Style="{StaticResource Dim}" Margin="0,6,0,0" Text="When off, closing the window quits and resets the proxy and TUN."/>
            <CheckBox x:Name="ChkCompactStart" Content="Start with the compact bar" Margin="0,10,0,0" Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged"/>
            <Button x:Name="BtnSwitchCompact" Content="Switch to compact bar now" Style="{StaticResource GhostButton}"
                    Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnGoCompactClick"/>

            <TextBlock x:Name="ThemeLabel" Text="THEME" Style="{StaticResource MicroLabel}" Margin="0,22,0,0"/>
            <Border x:Name="ThemeSwitch" Background="{DynamicResource CardBg}" CornerRadius="8"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    HorizontalAlignment="Left" Padding="4" Margin="0,8,0,0" Cursor="Hand"
                    MouseLeftButtonUp="OnThemeToggleClick" ToolTip="Dark / light theme">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ThemeLightPart" CornerRadius="6" Padding="18,7">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☀" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ThemeLightText" Text="Light" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border x:Name="ThemeDarkPart" Grid.Column="1" CornerRadius="6" Padding="18,7">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☾" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ThemeDarkText" Text="Dark" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <TextBlock x:Name="LanguageLabel" Text="LANGUAGE" Style="{StaticResource MicroLabel}" Margin="0,22,0,0"/>
            <ComboBox x:Name="LangBox" Width="180" HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="OnLanguageChanged">
              <ComboBoxItem Content="English" Tag="en"/>
              <ComboBoxItem Content="فارسی" Tag="fa"/>
            </ComboBox>

            <TextBlock x:Name="PortsLabel" Text="PORTS" Style="{StaticResource MicroLabel}" Margin="0,22,0,0"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,8,10">
                <TextBlock x:Name="PortLabel1" Text="Main SOCKS" Style="{StaticResource Dim}"/>
                <TextBox x:Name="PortMainSocks" TextChanged="OnPortChanged" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,10">
                <TextBlock x:Name="PortLabel2" Text="Main HTTP" Style="{StaticResource Dim}"/>
                <TextBox x:Name="PortMainHttp" TextChanged="OnPortChanged" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Margin="0,0,8,10">
                <TextBlock x:Name="PortLabel3" Text="Chain hop (anti-loop)" Style="{StaticResource Dim}"/>
                <TextBox x:Name="PortVlessOnly" TextChanged="OnPortChanged" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                <TextBlock x:Name="PortLabel4" Text="Psiphon SOCKS" Style="{StaticResource Dim}"/>
                <TextBox x:Name="PortPsiSocks" TextChanged="OnPortChanged" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Margin="0,0,8,0">
                <TextBlock x:Name="PortLabel5" Text="Psiphon HTTP" Style="{StaticResource Dim}"/>
                <TextBox x:Name="PortPsiHttp" TextChanged="OnPortChanged" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="DnsLabel" Text="DNS" Style="{StaticResource MicroLabel}" Margin="0,22,0,0"/>
            <ComboBox x:Name="DnsBox" Width="260" HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="OnDnsChanged">
              <ComboBoxItem Content="Automatic (system)" Tag="auto"/>
              <ComboBoxItem Content="1.1.1.1 (Cloudflare)" Tag="1.1.1.1"/>
              <ComboBoxItem Content="1.1.1.1 via DoH" Tag="doh:1.1.1.1"/>
              <ComboBoxItem Content="8.8.8.8 (Google)" Tag="8.8.8.8"/>
              <ComboBoxItem Content="8.8.8.8 via DoH" Tag="doh:8.8.8.8"/>
              <ComboBoxItem Content="9.9.9.9 (Quad9)" Tag="9.9.9.9"/>
              <ComboBoxItem Content="9.9.9.9 via DoH" Tag="doh:9.9.9.9"/>
            </ComboBox>

            <TextBlock x:Name="SubUpdatesLabel" Text="SUBSCRIPTION AUTO-UPDATE" Style="{StaticResource MicroLabel}" Margin="0,22,0,0"/>
            <ComboBox x:Name="SubHoursBox" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="OnSubscriptionIntervalChanged">
              <ComboBoxItem Content="Every 6 hours" Tag="6"/>
              <ComboBoxItem Content="Every 12 hours" Tag="12"/>
              <ComboBoxItem Content="Every 24 hours (daily)" Tag="24"/>
              <ComboBoxItem Content="Off" Tag="0"/>
            </ComboBox>

            <TextBlock x:Name="WarpLabel" Text="WARP CHAIN HOP" Style="{StaticResource MicroLabel}" Margin="0,22,0,0"/>
            <TextBlock x:Name="WarpHint" Style="{StaticResource Dim}" Margin="0,6,0,4"
                       Text="Generate with wgcf (register + generate). Used by the V2Ray-over-WARP mode."/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="WarpKeyLabel" Text="Private key (base64)" Style="{StaticResource Dim}"/>
                <TextBox x:Name="WarpKey" TextChanged="OnWarpChanged" Margin="0,4,0,8"/>
                <TextBlock x:Name="WarpAddrLabel" Text="Interface address" Style="{StaticResource Dim}"/>
                <TextBox x:Name="WarpAddr" TextChanged="OnWarpChanged" Margin="0,4,0,8"/>
                <TextBlock x:Name="WarpResLabel" Text="Reserved bytes" Style="{StaticResource Dim}"/>
                <TextBox x:Name="WarpRes" TextChanged="OnWarpChanged" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="BtnWarpImport" Grid.Column="1" Content="Import from WireGuard conf…"
                      Style="{StaticResource GhostButton}" Click="OnWarpImportClick"
                      VerticalAlignment="Top" Margin="8,20,0,0"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24,20" Margin="12,0,0,0" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock x:Name="EnginesLabel" Text="ENGINES" Style="{StaticResource MicroLabel}"/>
            <TextBlock x:Name="EnginesTitle" Text="Binaries" Style="{StaticResource Headline}" FontSize="20" Margin="0,8,0,14"/>
            <TextBlock x:Name="CoreStatusText" Style="{StaticResource Dim}" FontFamily="{StaticResource MonoFont}"
                       TextWrapping="Wrap" Text="checking…"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="BtnDownloadCores" Content="Download missing" Style="{StaticResource PrimaryButton}" Click="OnDownloadCoresClick"/>
              <Button x:Name="BtnUpdateXray" Content="Update Xray" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                      Click="OnUpdateXrayClick" ToolTip="Replace cores\xray.exe with the pinned release (needed for FinalMask). Stop the tunnel first."/>
              <Button x:Name="BtnRefreshCores" Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnRefreshCoresClick"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Border}" Margin="0,18,0,0"/>
            <TextBlock x:Name="TerminalLabel" Text="TERMINAL" Style="{StaticResource MicroLabel}" Margin="0,16,0,0"/>
            <Button x:Name="BtnTerminal" Content="Apply proxy to future terminals" Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="OnApplyTerminalClick" HorizontalAlignment="Left"/>
            <Button x:Name="BtnRuntime" Content="Open runtime folder" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="OnOpenRuntimeClick" HorizontalAlignment="Left"/>

            <Border Height="1" Background="{DynamicResource Border}" Margin="0,18,0,0"/>
            <TextBlock x:Name="MaintenanceLabel" Text="MAINTENANCE" Style="{StaticResource MicroLabel}" Margin="0,16,0,0"/>
            <TextBlock x:Name="FlushHint" Style="{StaticResource Dim}" Margin="0,6,0,8"
                       Text="Stops all engines, resets the system proxy and terminal variables, flushes DNS."/>
            <Button x:Name="BtnFlushNetwork" Content="Flush network" Style="{StaticResource GhostButton}" Margin="0,0,0,0" Click="OnFlushNetworkClick" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
