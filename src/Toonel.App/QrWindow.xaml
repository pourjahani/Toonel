<Window x:Class="Toonel.App.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toonel" Height="430" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource SansSerif}"
        WindowStyle="ToolWindow">
  <StackPanel Margin="24">
    <TextBlock x:Name="TitleText" Text="Profile name" FontWeight="SemiBold" FontSize="15"
               Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,14,0,0"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            HorizontalAlignment="Center">
      <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform"/>
    </Border>
    <TextBlock x:Name="HintText" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"
               Text="Scan with your VPN client app to import this server."/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
      <Button x:Name="BtnCopy" Content="Copy link" Style="{StaticResource GhostButton}"
              Padding="14,8" Click="OnCopyClick"/>
      <Button Content="Close" Style="{StaticResource PrimaryButton}"
              Padding="14,8" Margin="8,0,0,0" Click="OnCloseClick"/>
    </StackPanel>
  </StackPanel>
</Window>
